#!/bin/sh
# Run mac-music-gen from the project's own virtual environment, from any folder.
#
#   bin/mac-music-gen generate --prompt "calm lo-fi piano" --seconds 60 --out bed.wav
#
# Generation needs the Mac's GPU. Agent sandboxes block Metal, so run GPU commands in your own terminal.
set -e
root="$(cd "$(dirname "$0")/.." && pwd)"
[ -x "$root/.venv/bin/mac-music-gen" ] || { echo "missing $root/.venv; run 'uv sync --extra gpu' in $root" >&2; exit 1; }
exec "$root/.venv/bin/mac-music-gen" "$@"
